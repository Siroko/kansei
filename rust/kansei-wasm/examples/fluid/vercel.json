{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "development": true,
      "**": false
    }
  },
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p proxy && echo 'This site proxies https://kansei.graphics/examples/fluid/ (see vercel.json).' > proxy/README.txt",
  "outputDirectory": "proxy",
  "rewrites": [
    {
      "source": "/examples/fluid/:path*",
      "destination": "https://kansei.graphics/examples/fluid/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://kansei.graphics/examples/fluid/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' http://localhost:* http://localhost https://felixmartinez.dev https://*.felixmartinez.dev https://kansei.graphics https://*.kansei.graphics"
        }
      ]
    }
  ]
}
