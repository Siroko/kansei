{
  "name": "kansei",
  "private": false,
  "version": "0.1.0",
  "description": "A WebGPU engine in TypeScript: deferred and forward rendering, shadows, voxel and ray-traced GI, post-processing, GPU fluids, cluster LOD, animation and KTX2 textures, sharing its WGSL with the Rust engine in the same repository.",
  "keywords": [
    "webgpu",
    "wgsl",
    "3d",
    "rendering",
    "engine",
    "global-illumination",
    "ray-tracing",
    "gpu",
    "compute",
    "ktx2"
  ],
  "license": "MIT",
  "author": "Felix Martinez",
  "homepage": "https://kansei.graphics",
  "bugs": {
    "url": "https://github.com/Siroko/kansei/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Siroko/kansei"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "node scripts/run-tests.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky install",
    "copy-examples": "cp -r examples dist/examples && rm -rf dist/examples/pack",
    "update-imports": "node scripts/bundle-examples-update-imports.cjs",
    "copy-site": "cp -R site/. dist/",
    "copy-wasm-examples": "bash scripts/fetch-wasm-examples.sh",
    "check-no-packs": "bash scripts/check-no-packs.sh",
    "bundle-examples": "npm run build && npm run copy-examples && npm run update-imports && npm run copy-site && npm run copy-wasm-examples && npm run check-no-packs",
    "prepack": "npm run build"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    }
  },
  "peerDependencies": {
    "@webgpu/types": "^0.1.48"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "glob": "^11.0.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.4",
    "vite-plugin-mkcert": "^1.17.6",
    "vite-plugin-wasm": "^3.3.0"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  },
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "gl-matrix": "^3.4.3"
  }
}
